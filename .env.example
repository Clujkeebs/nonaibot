# ── REQUIRED: Alpaca API credentials ─────────────────────────────────────────
# Never commit real keys. Set these as Railway environment variables.
#
# IMPORTANT: paper and live keys are NOT interchangeable.
#   - TRADING_MODE=live   → use LIVE keys from https://app.alpaca.markets
#   - TRADING_MODE=paper  → use PAPER keys from
#                           https://app.alpaca.markets/paper/dashboard/overview
# If the keys don't match the mode, market DATA still loads but every TRADING
# call fails with: {"code":40110000,"message":"request is not authorized"}.
APCA_API_KEY_ID=your_alpaca_live_key_id
APCA_API_SECRET_KEY=your_alpaca_live_secret_key
# Leave APCA_API_BASE_URL unset — the bot picks the right endpoint from TRADING_MODE.

# ── TRADING MODE ─────────────────────────────────────────────────────────────
# "live" (default — REAL MONEY) or "paper" (simulated dry-run).
# This is a funded live account running the $100 challenge, so default is live.
TRADING_MODE=live

# ── DATABASE ─────────────────────────────────────────────────────────────────
# On Railway: mount a volume at /data and set DB_PATH=/data/bot.db
DB_PATH=bot.db

# ── NOTIFICATIONS (all optional) ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SERVER PORT ───────────────────────────────────────────────────────────────
PORT=8080
