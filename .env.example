# ── REQUIRED: Alpaca API credentials ─────────────────────────────────────────
# Never commit real keys. Set these as Railway environment variables.
APCA_API_KEY_ID=your_alpaca_key_id
APCA_API_SECRET_KEY=your_alpaca_secret_key
APCA_API_BASE_URL=https://paper-api.alpaca.markets   # paper default

# ── TRADING MODE ─────────────────────────────────────────────────────────────
# "paper" (default, safe) or "live" (real money — set deliberately)
TRADING_MODE=paper

# ── DATABASE ─────────────────────────────────────────────────────────────────
# On Railway: mount a volume at /data and set DB_PATH=/data/bot.db
DB_PATH=bot.db

# ── NOTIFICATIONS (all optional) ─────────────────────────────────────────────
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── SERVER PORT ───────────────────────────────────────────────────────────────
PORT=8080
